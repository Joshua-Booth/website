{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en,en-GB",
  "dictionaries": [
    "typescript",
    "node",
    "npm",
    "html",
    "html-symbol-entities",
    "css",
    "software-terms",
    "fullstack",
    "companies",
    "fonts",
    "filetypes",
    "public-licenses",
    "git",
    "bash",
    "shellscript"
  ],
  "files": [
    "{app,src,scripts}/**/*.{ts,tsx,css,mdx}",
    "**/*.md",
    "*.toml",
    "package.json",
    "*.config.{ts,js,json}"
  ],
  "ignorePaths": [
    "**/*.svg",
    "**/node_modules/**",
    "**/.next/**",
    "**/.netlify/**",
    "**/coverage/**",
    "**/audit-output/**",
    "**/pnpm-lock.yaml",
    "**/*.tsbuildinfo"
  ],
  "words": [
    "Archivo",
    "commitlint",
    "cqw",
    "creact",
    "cutlist",
    "FSD",
    "gitmoji",
    "gitmojis",
    "joshuabooth",
    "lefthook",
    "opengraph",
    "oxfmt",
    "oxlint",
    "PCOS",
    "posthog",
    "relayout",
    "sonarjs",
    "steiger",
    "stylex",
    "stylexjs",
    "tblock",
    "tsgolint",
    "typegen",
    "undos",
    "unstub",
    "wdth"
  ],
  "ignoreRegExpList": ["phc_\\w+"]
}
